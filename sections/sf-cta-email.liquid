<section class="sfh-cta">
  <div class="sfh-cta__pill sfh-cta__pill--blue sfh-cta__pill--p1">SIP &amp; REFLECT</div>
  <div class="sfh-cta__pill sfh-cta__pill--orange sfh-cta__pill--p2">ENERGY BITES</div>
  <div class="sfh-cta__pill sfh-cta__pill--pink sfh-cta__pill--p3">INSIDE SCOOP</div>
  <div class="sfh-cta__pill sfh-cta__pill--green sfh-cta__pill--p4">SHAKE IT UP</div>

  <div class="sfh-cta__content">
    <h2 class="sfh-cta__headline">Not sure if this<br>is your thing?</h2>
    <p class="sfh-cta__sub">Get a free sample prompt in your inbox. No commitment.</p>

    <form class="sfh-cta__form" action="/contact" method="post">
      <input type="hidden" name="form_type" value="contact">
      <input type="hidden" name="utf8" value="✓">
      <input type="hidden" name="contact[tags]" value="homepage-sample-request">
      <div class="sfh-cta__input-wrap">
        <input
          type="email"
          name="contact[email]"
          placeholder="you@stickyfeelings.in"
          class="sfh-cta__input"
          required
          aria-label="Your email address"
        >
        <button type="submit" class="sfh-cta__btn">Send me one</button>
      </div>
    </form>
    <p class="sfh-cta__disclaimer">No spam, we hate it too</p>
  </div>
</section>

