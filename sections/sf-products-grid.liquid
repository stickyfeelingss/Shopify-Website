{%- liquid
  assign juicebox   = collections['the-emotional-juice-box'].products | first
  assign notebooks  = collections['notebooks'].products | first
  assign cards      = collections['compliment-cards'].products | first
-%}

<section class="sfh-products">
  <div class="sfh-products__head">
    <h2 class="sfh-products__headline">little things for big feelings</h2>
    <a href="/collections/all" class="sfh-explore-all">EXPLORE ALL <span class="sfh-arrow">→</span></a>
  </div>

  <div class="sfh-products__grid">

    {%- comment -%} Card 1 — Emotional Juice Box {%- endcomment -%}
    <div class="sfh-card">
      <div class="sfh-card__badge sfh-card__badge--blue">FLAGSHIP</div>
      <a href="{{ juicebox.url | default: '/collections/the-emotional-juice-box' }}" class="sfh-card__img-link">
        <div class="sfh-card__img-wrap">
          {%- if juicebox.featured_image -%}
            <img src="{{ juicebox.featured_image | image_url: width: 500 }}" alt="{{ juicebox.title }}" class="sfh-card__img" loading="lazy">
          {%- else -%}
            <img src="https://www.figma.com/api/mcp/asset/9b25c288-6ada-4824-bc43-ac9f6b686d61" alt="Emotional Juice Box" class="sfh-card__img" loading="lazy">
          {%- endif -%}
        </div>
      </a>
      <div class="sfh-card__body">
        <div class="sfh-card__meta">
          <span class="sfh-card__name">{{ juicebox.title | default: 'Emotional Juice Box' }}</span>
          <span class="sfh-card__detail">100 prompt cards</span>
        </div>
        <div class="sfh-card__meta">
          <span class="sfh-card__price">from ₹{{ juicebox.price_min | divided_by: 100 | default: '349' }}</span>
          <span class="sfh-card__sub">For all your micro emotions and the things you let slide</span>
        </div>
        <a href="{{ juicebox.url | default: '/collections/the-emotional-juice-box' }}" class="sfh-card__explore">EXPLORE <span class="sfh-arrow">→</span></a>
      </div>
    </div>

    {%- comment -%} Card 2 — Notebooks {%- endcomment -%}
    <div class="sfh-card">
      <div class="sfh-card__badge sfh-card__badge--yellow">NEW</div>
      <a href="{{ notebooks.url | default: '/collections/notebooks' }}" class="sfh-card__img-link">
        <div class="sfh-card__img-wrap">
          {%- if notebooks.featured_image -%}
            <img src="{{ notebooks.featured_image | image_url: width: 500 }}" alt="{{ notebooks.title }}" class="sfh-card__img" loading="lazy">
          {%- else -%}
            <img src="https://www.figma.com/api/mcp/asset/c6e4908b-b444-43e3-ab22-736f1fc431e1" alt="Notepads with Feelings" class="sfh-card__img" loading="lazy">
          {%- endif -%}
        </div>
      </a>
      <div class="sfh-card__body">
        <div class="sfh-card__meta">
          <span class="sfh-card__name">{{ notebooks.title | default: 'Notepads with Feelings' }}</span>
          <span class="sfh-card__detail">6 varieties</span>
        </div>
        <div class="sfh-card__meta">
          <span class="sfh-card__price">from ₹{{ notebooks.price_min | divided_by: 100 | default: '350' }}</span>
          <span class="sfh-card__sub">One notebook for a specific purpose, efficient and handy</span>
        </div>
        <a href="{{ notebooks.url | default: '/collections/notebooks' }}" class="sfh-card__explore">EXPLORE <span class="sfh-arrow">→</span></a>
      </div>
    </div>

    {%- comment -%} Card 3 — Compliment Cards {%- endcomment -%}
    <div class="sfh-card">
      <div class="sfh-card__badge sfh-card__badge--green">LIMITED</div>
      <a href="{{ cards.url | default: '/collections/compliment-cards' }}" class="sfh-card__img-link">
        <div class="sfh-card__img-wrap">
          {%- if cards.featured_image -%}
            <img src="{{ cards.featured_image | image_url: width: 500 }}" alt="{{ cards.title }}" class="sfh-card__img" loading="lazy">
          {%- else -%}
            <img src="https://www.figma.com/api/mcp/asset/439bd0f6-7ad1-478b-830b-dc91ebba914f" alt="Compliment Cards" class="sfh-card__img" loading="lazy">
          {%- endif -%}
        </div>
      </a>
      <div class="sfh-card__body">
        <div class="sfh-card__meta">
          <span class="sfh-card__name">{{ cards.title | default: 'Compliment Cards' }}</span>
          <span class="sfh-card__detail">3 varieties</span>
        </div>
        <div class="sfh-card__meta">
          <span class="sfh-card__price">from ₹{{ cards.price_min | divided_by: 100 | default: '299' }}</span>
          <span class="sfh-card__sub">Fill-in-the-blank compliment cards to make someone feel special</span>
        </div>
        <a href="{{ cards.url | default: '/collections/compliment-cards' }}" class="sfh-card__explore">EXPLORE <span class="sfh-arrow">→</span></a>
      </div>
    </div>

  </div>

  {%- comment -%} Scrolling marquee {%- endcomment -%}
  <div class="sfh-marquee" aria-hidden="true">
    <div class="sfh-marquee__track">
      {%- for i in (1..6) -%}
        <span>STICKY FEELINGS</span><span class="sfh-marquee__dot">✦</span>
        <span>STICKY FEELINGS</span><span class="sfh-marquee__dot">✦</span>
        <span>STICKY FEELINGS</span><span class="sfh-marquee__dot">✦</span>
      {%- endfor -%}
    </div>
  </div>
</section>
